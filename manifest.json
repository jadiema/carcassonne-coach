{
  "name": "Carcassonne Coach — BGA Analyzer",
  "description": "Analyse vos parties terminées et vos replays de Carcassonne sur Board Game Arena. Projet indépendant, sans lien avec Hans im Glück ni Board Game Arena.",
  "version": "3.1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5555/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Carcassonne Coach"
  },
  "icons": {
    "48": "images/icon48.png",
    "96": "images/icon96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boardgamearena.com/*",
        "https://*.boardgamearena.com/*",
        "https://boardgamearena.net/*",
        "https://*.boardgamearena.net/*"
      ],
      "all_frames": true,
      "js": [
        "livre.js",
        "probabilites.js",
        "content-script.js"
      ],
      "css": [
        "content-style.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "jgrisolia@free.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/jadiema/carcassonne-coach/main/updates.json"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}