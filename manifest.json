{
  "name": "Carcassonne Coach — BGA Analyzer",
  "description": "Extrait l'état d'une partie Carcassonne sur BGA pour analyse tactique post-partie.",
  "version": "2.1.0",
  "manifest_version": 3,
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:5555/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Carcassonne Coach"
  },
  "icons": {
    "48": "images/icon48.png",
    "96": "images/icon96.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boardgamearena.com/*",
        "https://*.boardgamearena.com/*",
        "https://boardgamearena.net/*",
        "https://*.boardgamearena.net/*"
      ],
      "all_frames": true,
      "js": [
        "content-script.js"
      ],
      "css": [
        "content-style.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "carcassonne-coach@votre-email.com",
      "strict_min_version": "109.0"
    }
  }
}